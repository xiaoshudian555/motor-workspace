#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
SCAFFOLD_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"
REPO_ROOT="$(cd -- "${SCAFFOLD_ROOT}/.." && pwd)"
export PYTHONPATH="${SCAFFOLD_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"
exec python3 -m motor_workspace "$@"
