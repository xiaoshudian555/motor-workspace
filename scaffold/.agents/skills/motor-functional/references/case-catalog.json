{
  "schema_version": "mws.functional.catalog.v1",
  "features": {
    "metrics": {
      "aliases": ["metric", "prometheus", "指标"],
      "default_cases": ["metrics.exposed", "metrics.request-updated"]
    },
    "tracing": {
      "aliases": ["trace", "链路追踪", "链路"],
      "default_cases": ["tracing.request-correlated"]
    },
    "inference-request": {
      "aliases": ["推理请求", "请求打通", "curl通", "curl 通", "inference request"],
      "default_cases": ["inference-request.non-stream", "inference-request.stream"]
    },
    "tls": {
      "aliases": ["https", "证书", "双向认证", "mtls"],
      "default_cases": ["tls.valid-client", "tls.invalid-client"]
    },
    "parameter-passthrough": {
      "aliases": ["参数透传", "透传", "passthrough"],
      "default_cases": ["parameter-passthrough.effective"]
    },
    "overload-control": {
      "aliases": ["overload", "限流", "拒识", "过载控制"],
      "default_cases": ["overload-control.rejection-shape"]
    },
    "api-key": {
      "aliases": ["api key", "apikey", "鉴权"],
      "default_cases": ["api-key.valid", "api-key.missing", "api-key.invalid"]
    }
  },
  "cases": {
    "metrics.exposed": {
      "feature": "metrics",
      "adapter": "metrics-query",
      "intent": "Coordinator observability /metrics exposes Prometheus families and samples.",
      "expected": {"http_status": 200, "prometheus_data": true},
      "evidence": ["metrics_snapshot"]
    },
    "metrics.request-updated": {
      "feature": "metrics",
      "adapter": "metrics-query",
      "intent": "A single controlled request updates the expected metric series.",
      "expected": {"metric": "vllm:request_success_total", "delta": "positive"},
      "evidence": ["metrics_before", "request", "metrics_after"]
    },
    "tracing.request-correlated": {
      "feature": "tracing",
      "adapter": "trace-query",
      "intent": "A controlled request with an injected W3C traceparent can be correlated to Tempo trace evidence.",
      "expected": {"backend": "tempo", "trace_id": "matched", "request_id": "correlated"},
      "evidence": ["request", "trace"]
    },
    "inference-request.non-stream": {
      "feature": "inference-request",
      "adapter": "inference-http",
      "intent": "A real non-stream request reaches Motor and returns generated output.",
      "expected": {"http_status": 200, "generated_output": true},
      "evidence": ["request", "response"]
    },
    "inference-request.stream": {
      "feature": "inference-request",
      "adapter": "inference-http",
      "intent": "A real stream request reaches Motor and returns generated SSE output.",
      "expected": {"http_status": 200, "choice_events": true, "done": true},
      "evidence": ["request", "response"]
    },
    "api-key.valid": {
      "feature": "api-key",
      "adapter": "openai-http",
      "intent": "A valid configured API key is accepted.",
      "expected": {"http_status_class": "2xx"},
      "evidence": ["request", "response"]
    },
    "api-key.missing": {
      "feature": "api-key",
      "adapter": "openai-http",
      "intent": "A request without the required API key is rejected.",
      "expected": {"http_status_class": "4xx"},
      "evidence": ["request_headers_redacted", "response"]
    },
    "api-key.invalid": {
      "feature": "api-key",
      "adapter": "openai-http",
      "intent": "An invalid API key is rejected.",
      "expected": {"http_status_class": "4xx"},
      "evidence": ["request_headers_redacted", "response"]
    },
    "tls.valid-client": {
      "feature": "tls",
      "adapter": "tls-http",
      "intent": "A client with the expected trust and certificate material can connect.",
      "expected": {"handshake": "accepted"},
      "evidence": ["tls_summary", "response"]
    },
    "tls.invalid-client": {
      "feature": "tls",
      "adapter": "tls-http",
      "intent": "A client with invalid trust or certificate material is rejected.",
      "expected": {"handshake": "rejected"},
      "evidence": ["tls_summary"]
    },
    "parameter-passthrough.effective": {
      "feature": "parameter-passthrough",
      "adapter": "openai-http",
      "intent": "The selected request parameter reaches and affects the target behavior.",
      "expected": {"configured_effect_observed": true},
      "evidence": ["request", "response", "server_observation"]
    },
    "overload-control.rejection-shape": {
      "feature": "overload-control",
      "adapter": "load-http",
      "intent": "Enabled overload control returns the designed rejection status and body.",
      "expected": {"configured_rejection_observed": true},
      "evidence": ["load_shape", "responses"]
    }
  }
}
